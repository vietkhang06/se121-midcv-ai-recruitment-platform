# Copy to .env.production, fill every required value, and keep it out of Git.
# Generate secrets with: openssl rand -hex 32
PUBLIC_DOMAIN=midcv.example.com
POSTGRES_DB=midcv
POSTGRES_USER=midcv_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_VOLUME_NAME=midcv_production_pgdata
UPLOADS_VOLUME_NAME=midcv_production_uploads
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS

# Bootstrap happens only when the database has no ADMIN account.
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD

# Primary LLM provider. Never commit this file or expose this key to the frontend.
AI_PROVIDER=auto
LLM_PRIMARY_ENABLED=true
LLM_PRIMARY_PROVIDER=openai_compatible
LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
LLM_PRIMARY_API_KEY=REPLACE_WITH_REAL_PROVIDER_KEY
LLM_PRIMARY_MODEL=REPLACE_WITH_SUPPORTED_MODEL_NAME
LLM_PRIMARY_TIMEOUT_SECONDS=180
LLM_PRIMARY_MAX_RETRIES=1
LLM_FALLBACK_ENABLED=false
# Ollama is installed on the Docker host or a reachable private server.
# Pull OLLAMA_CHAT_MODEL (if fallback is enabled) and EMBEDDING_MODEL before acceptance.
# On the Docker host, Ollama must listen on an address reachable via the host-gateway.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=dna5rm/granite4.2:3b-8k
EMBEDDING_MODEL=bge-m3
OCR_ENABLED=true
OCR_LANGUAGES=vie+eng

# SMTP delivery (not MOCK/Mailpit).
EMAIL_MODE=SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=noreply@example.com
MIDCV_INBOX_EMAIL_ENABLED=true
MIDCV_INBOX_EMAIL_FROM=noreply@example.com

# Optional OAuth configuration; provider callback URLs must match provider consoles.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_TOKEN=

# Docker image tags (can be overridden by the deployment script for rollback).
BACKEND_IMAGE=midcv-backend:production
FRONTEND_IMAGE=midcv-frontend:production
WORKER_IMAGE=midcv-ai-worker:production
WORKER_ENABLED=true
AI_TIMEOUT_SECONDS=360
