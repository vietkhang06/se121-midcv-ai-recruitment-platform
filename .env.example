# ============================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# AI RECRUITMENT PLATFORM
# ============================================================

# 1. DATABASE CONFIGURATION (PostgreSQL + Pgvector)
DATABASE_URL=jdbc:postgresql://localhost:5432/airecruit_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_secure_pass

# 2. JWT SECURITY CONFIGURATION
# Must be a base64 encoded string of at least 256 bits
JWT_SECRET=d9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# 3. AI & LLM PROVIDER CONFIGURATION (PRIMARY + OLLAMA FALLBACK)
LLM_PRIMARY_PROVIDER=openai_compatible
LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_PRIMARY_TIMEOUT_SECONDS=180
LLM_PRIMARY_MAX_RETRIES=1

LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=dna5rm/granite4.2:3b-8k
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=0

ENABLE_DEV_AI_TEST_ENDPOINTS=false
USE_MOCK_LLM=false

# Optional GitHub Personal Access Token (PAT) for extended GitHub rate limits
GITHUB_TOKEN=


# 4. FILE STORAGE CONFIGURATION
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=15

# 5. SERVER PORTS CONFIGURATION
PORT_FRONTEND=3000
PORT_BACKEND=8080
PORT_AI_SERVICE=8000

# 6. INITIAL ADMIN BOOTSTRAP (Optional - only runs when database contains 0 ADMIN users)
# Never commit real credentials to version control.
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change_this_to_a_secure_password

