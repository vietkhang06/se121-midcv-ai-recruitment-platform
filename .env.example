# ============================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# AI RECRUITMENT PLATFORM
# ============================================================

# 1. DATABASE CONFIGURATION (PostgreSQL + Pgvector)
DATABASE_URL=jdbc:postgresql://localhost:5432/airecruit_db
# Keep this port equal to the port in DATABASE_URL when changing the host mapping.
POSTGRES_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_secure_pass

# 2. JWT SECURITY CONFIGURATION
# Use a unique random string of at least 32 UTF-8 bytes. Replace the development example before deployment.
JWT_SECRET=d9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_PRIMARY_TIMEOUT_SECONDS=180
LLM_PRIMARY_MAX_RETRIES=1


ENABLE_DEV_AI_TEST_ENDPOINTS=false

# Optional GitHub Personal Access Token (PAT) for extended GitHub rate limits
GITHUB_TOKEN=


# 4. FILE STORAGE CONFIGURATION
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=10

# 5. SERVER PORTS CONFIGURATION
PORT_FRONTEND=3000
PORT_BACKEND=8080
PORT_AI_SERVICE=8000

# 7. Server-side OAuth (credentials stay in the backend environment)
BACKEND_PUBLIC_URL=http://localhost:8080
FRONTEND_PUBLIC_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID= 
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# 6. INITIAL ADMIN BOOTSTRAP (Optional - only runs when database contains 0 ADMIN users)
# Never commit real credentials to version control.
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change_this_to_a_secure_password


# 8. Email delivery: MOCK only stores development tokens; SMTP sends real messages.
EMAIL_MODE=SMTP
MAIL_FROM=noreply@midcv.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# LinkedIn: enable Sign In with LinkedIn using OpenID Connect in the developer portal.
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

EMBEDDING_MODEL=text-embedding-3-small

# Embedding API compatible with POST /embeddings and 1024 dimensions.
# Leave the URL blank to use the chat API base. Supply a separate key for a different endpoint.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
