OLLAMA_MODEL=dna5rm/granite4.2:3b-8k
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
USE_MOCK_LLM=false

OPENAI_API_KEY=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
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
