{
  "info": {
    "_postman_id": "4b971dc0-5847-49ec-8255-bfa3860bb4d1",
    "name": "MidCV-LLM-Testing",
    "description": "Postman test suite for isolated CV document extraction and LLM structuring (Primary OpenAI-compatible + Fallback Ollama).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 — Primary Models",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{primary_api_key}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{primary_base_url}}/models",
          "host": ["{{primary_base_url}}"],
          "path": ["models"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is valid JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "pm.test(\"Contains models list\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data || jsonData.models || jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 — Primary Chat Smoke Test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{primary_api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"{{primary_model}}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a test assistant. Return ONLY valid JSON: {\\\"status\\\": \\\"ok\\\"}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"ping\"\n    }\n  ],\n  \"temperature\": 0,\n  \"stream\": false\n}"
        },
        "url": {
          "raw": "{{primary_base_url}}/chat/completions",
          "host": ["{{primary_base_url}}"],
          "path": ["chat", "completions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response contains choices\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.choices).to.be.an('array').that.is.not.empty;",
              "});",
              "pm.test(\"Content is present and parses to JSON\", function () {",
              "    var jsonData = pm.response.json();",
              "    var content = jsonData.choices[0].message.content;",
              "    pm.expect(content).to.be.a('string').and.not.empty;",
              "    var clean = content.replace(/```json/g, '').replace(/```/g, '').trim();",
              "    var parsed = JSON.parse(clean);",
              "    pm.expect(parsed).to.be.an('object');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03 — Extract CV to Raw Text",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "01_single_column_tech_cv.pdf"
            }
          ]
        },
        "url": {
          "raw": "{{ai_worker_base_url}}/internal/ai/dev/extract-text",
          "host": ["{{ai_worker_base_url}}"],
          "path": ["internal", "ai", "dev", "extract-text"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Extraction result is valid\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.rawText).to.be.a('string').and.not.empty;",
              "    pm.expect(jsonData.document.characterCount).to.be.above(0);",
              "    pm.expect(jsonData.document.extractionMethod).to.be.a('string');",
              "    pm.expect(jsonData.providerUsed).to.be.undefined;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "04 — Structure Raw Text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rawText\": \"NGUYEN TUAN ANH\\nSenior Java Backend Developer\\nEmail: tuananh.nguyen@example.com\\nSkills: Java, Spring Boot, PostgreSQL, Docker\\nExperience: FinTech Solutions Vietnam - Senior Developer\"\n}"
        },
        "url": {
          "raw": "{{ai_worker_base_url}}/internal/ai/dev/structure-cv",
          "host": ["{{ai_worker_base_url}}"],
          "path": ["internal", "ai", "dev", "structure-cv"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Primary LLM used with valid JSON schema\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.providerUsed).to.eql(\"primary\");",
              "    pm.expect(jsonData.fallbackUsed).to.be.false;",
              "    pm.expect(jsonData.validation.jsonValid).to.be.true;",
              "    pm.expect(jsonData.validation.schemaValid).to.be.true;",
              "    pm.expect(jsonData.data).to.be.an('object');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "05 — Primary Temporary Failure",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-Simulate-Primary-Status",
            "value": "503",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rawText\": \"NGUYEN TUAN ANH\\nSenior Java Backend Developer\\nEmail: tuananh.nguyen@example.com\\nSkills: Java, Spring Boot, PostgreSQL, Docker\"\n}"
        },
        "url": {
          "raw": "{{ai_worker_base_url}}/internal/ai/dev/structure-cv",
          "host": ["{{ai_worker_base_url}}"],
          "path": ["internal", "ai", "dev", "structure-cv"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Fallback triggered on simulated 503\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.fallbackUsed).to.be.true;",
              "    pm.expect(jsonData.providerUsed).to.eql(\"fallback\");",
              "    pm.expect(jsonData.fallbackReason).to.be.a('string');",
              "    pm.expect(jsonData.validation.jsonValid).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "06 — Invalid API Key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-Simulate-Primary-Status",
            "value": "401",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rawText\": \"NGUYEN TUAN ANH - Java Developer - Email: tuananh@example.com\"\n}"
        },
        "url": {
          "raw": "{{ai_worker_base_url}}/internal/ai/dev/structure-cv",
          "host": ["{{ai_worker_base_url}}"],
          "path": ["internal", "ai", "dev", "structure-cv"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"Zero key leakage in error response\", function () {",
              "    var text = pm.response.text();",
              "    pm.expect(text).to.not.include(\"sk-\");",
              "    pm.expect(text).to.include(\"Authentication failure\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "07 — Invalid Model",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-Simulate-Primary-Status",
            "value": "404",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rawText\": \"NGUYEN TUAN ANH - Java Developer - Email: tuananh@example.com\"\n}"
        },
        "url": {
          "raw": "{{ai_worker_base_url}}/internal/ai/dev/structure-cv",
          "host": ["{{ai_worker_base_url}}"],
          "path": ["internal", "ai", "dev", "structure-cv"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 404 Not Found\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test(\"Model configuration error reported\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"Model\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "08 — Invalid Raw Text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rawText\": \"   \"\n}"
        },
        "url": {
          "raw": "{{ai_worker_base_url}}/internal/ai/dev/structure-cv",
          "host": ["{{ai_worker_base_url}}"],
          "path": ["internal", "ai", "dev", "structure-cv"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Validation error detail returned\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"Raw text\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
