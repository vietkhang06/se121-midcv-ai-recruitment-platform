# ==============================================================================
# MIDCV AI-WORKER ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS, CREDENTIALS, OR API KEYS
# ==============================================================================

# 1. PRIMARY LLM CONFIGURATION
AI_PROVIDER=auto
LLM_PRIMARY_ENABLED=true
LLM_PRIMARY_PROVIDER=openai_compatible
LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_PRIMARY_TIMEOUT_SECONDS=180
LLM_PRIMARY_MAX_RETRIES=1

# 2. FALLBACK LLM CONFIGURATION
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=dna5rm/granite4.2:3b-8k
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=0

# 3. DEVELOPMENT / TEST ENDPOINTS
ENABLE_DEV_AI_TEST_ENDPOINTS=false

# 4. GITHUB ENRICHMENT
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# 5. OCR CONFIGURATION (TESSERACT 5.x)
OCR_ENABLED=true
TESSERACT_CMD=
TESSDATA_PREFIX=
OCR_LANGUAGES=vie+eng
OCR_TIMEOUT_SECONDS=120
OCR_DPI=300
OCR_MIN_TEXT_CHARS_PER_PAGE=40
OCR_MAX_PAGES=30
OCR_PSM=3