# ==============================================================================
# MIDCV AI-WORKER ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS, CREDENTIALS, OR API KEYS
# ==============================================================================

# 1. PRIMARY LLM CONFIGURATION
LLM_PRIMARY_ENABLED=true
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=ag/gemini-3.8-flash-low
LLM_PRIMARY_TIMEOUT_SECONDS=180
LLM_PRIMARY_MAX_RETRIES=1

# 2. FALLBACK LLM CONFIGURATION

# 3. DEVELOPMENT / TEST ENDPOINTS
ENABLE_DEV_AI_TEST_ENDPOINTS=false

# 4. GITHUB ENRICHMENT
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# 5. OCR CONFIGURATION (TESSERACT 5.x)
OCR_ENABLED=true
TESSERACT_CMD=
TESSDATA_PREFIX=
OCR_LANGUAGES=vie+eng
OCR_TIMEOUT_SECONDS=120
OCR_DPI=300
OCR_MIN_TEXT_CHARS_PER_PAGE=40
OCR_MAX_PAGES=30
OCR_PSM=3
# Conservative LLM post-processing: only high-confidence common-word edits are applied.
OCR_LLM_CORRECTION_ENABLED=true
OCR_LLM_CORRECTION_MIN_CONFIDENCE=0.92
OCR_LLM_CORRECTION_MAX_CHARS=40000

EMBEDDING_MODEL=text-embedding-3-small

# Embedding API compatible with POST /embeddings and 1024 dimensions.
# Leave the URL blank to use the chat API base. Supply a separate key for a different endpoint.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
